# --- hub: detection/ -------------------------------------------------------

# Spotify application credentials (https://developer.spotify.com/dashboard)
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://localhost:8888/callback/

# LAN address of the Yamaha receiver (MusicCast / Extended Control API)
YAMAHA_IP=

# --- display Pi: led-matrix/ and service-controller/ -----------------------

# Websocket endpoints served by the hub
AUDIO_WEBSOCKET_URL=ws://your-hub:9000/audio
SERVICE_CONTROLLER_WEBSOCKET_URL=ws://your-hub:9000/service_controller
